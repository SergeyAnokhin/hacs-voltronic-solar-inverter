{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the inverter gateway",
        "description": "Address of the RS232-to-TCP gateway (e.g. Elfin) connected to the inverter. Only one client can use the gateway at a time.",
        "data": {
          "host": "Host",
          "port": "Port",
          "fast_scan_interval": "Live values interval",
          "slow_scan_interval": "Settings and warnings interval"
        },
        "data_description": {
          "host": "IP address or host name of the gateway.",
          "port": "TCP port of the gateway (Elfin default: 8899).",
          "fast_scan_interval": "How often live values are read (QPIGS, QMOD).",
          "slow_scan_interval": "How often settings, option flags and warnings are read (QPIRI, QFLAG, QPIWS)."
        }
      }
    },
    "error": {
      "cannot_connect": "The inverter did not answer. Check the gateway address and that no other client is connected to it.",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This inverter is already configured."
    }
  },
