# Copy to secrets.yaml (it is git-ignored) and fill in your values.
# api_encryption_key: 32 random bytes, base64 (e.g. `openssl rand -base64 32`).
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
ap_password: "fallback-ap-password"
api_encryption_key: "REPLACE_WITH_BASE64_KEY"
ota_password: "your-ota-password"
